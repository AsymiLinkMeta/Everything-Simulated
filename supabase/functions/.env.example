# Edge-function secrets. Set them with:
#   supabase secrets set --env-file supabase/functions/.env   (never commit the real file)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.

# Public site + CORS
SITE_URL=https://www.everythingsimulated.com.au
ALLOWED_ORIGINS=https://staging.everythingsimulated.com.au,http://localhost:5173

# Function-to-function auth (stripe-webhook -> send-mail). Generate: openssl rand -hex 32
INTERNAL_FUNCTION_SECRET=

# Stripe (leave empty to keep card payments off)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
DEPOSIT_PERCENT=30

# Mail (Resend). Without a key, mail is logged to public.mail_log as "skipped".
RESEND_API_KEY=
MAIL_FROM=Everything Simulated <hello@everythingsimulated.com.au>
STAFF_INBOX=hello@everythingsimulated.com.au

# AI listing / prebuild / build-adviser copy. Without it, functions fall back to local drafts.
XAI_API_KEY=
