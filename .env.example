# Copy to .env.local for `npm run dev`. Only VITE_* values reach the browser,
# so never put a secret here. Edge-function secrets live in Supabase (see docs/ENV.md).

# Supabase project (Dashboard -> Project Settings -> API). The anon key is public by design.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public origin for canonicals, Open Graph, JSON-LD and the sitemap.
# Production: https://www.everythingsimulated.com.au  (default when unset)
# Staging:    your staging URL
VITE_SITE_URL=https://www.everythingsimulated.com.au

# "true" on staging/previews: noindex on every page and a Disallow-all robots.txt.
VITE_NOINDEX=false
